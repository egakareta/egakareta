{
    "$schema": "https://raw.githubusercontent.com/awjh/license-check-and-add/refs/heads/master/config-schema.json",
    "ignoreFile": ".gitignore",
    "ignore": [
        ".agents/**",
        ".wrangler/**",
        "assets/**",
        "web/zenfs.js",
        "supabase/**",
        "**/lcov.info",
        "**/*.md",
        "**/*.json",
        "**/*.lock",
        "**/*-env.d.ts",
        "**/*_types.ts",
        "**/.*"
    ],
    "licenseFormats": {
        "ts|js|rs": {
            "eachLine": {
                "prepend": "* "
            },
            "prepend": "/*\n",
            "append": "\n*/"
        },
        "toml|yml|^Dockerfile": {
            "eachLine": {
                "prepend": "# "
            }
        }
    },
    "license": ".config/license/header.txt",
    "defaultFormat": {
        "eachLine": {
            "prepend": " * "
        },
        "prepend": "/*\n",
        "append": "\n */"
    }
}
