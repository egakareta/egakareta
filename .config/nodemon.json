{
    "$schema": "https://json.schemastore.org/nodemon.json",
    "watch": [
        "src",
        "crates",
        "assets",
        "index.html",
        "scripts",
        "web",
        "build.rs",
        "Cargo.toml",
        ".cargo",
        "wrangler.jsonc",
        ".env.local",
        ".env.preview",
        ".env.production"
    ],
    "ignore": ["**/target/**"],
    "delay": 400,
    "ext": "*"
}
