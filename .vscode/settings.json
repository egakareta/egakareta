{
    "rust-analyzer.diagnostics.disabled": ["inactive-code"],
    "rust-analyzer.testExplorer": true,
    "prettier.configPath": ".config/.prettierrc",
    "prettier.ignorePath": ".config/.prettierignore",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/.wrangler": true,
        "**/node_modules": true,
        "**/.editorconfig": true,
        "**/dist": true,
        "lcov.info": true
    },
    "[toml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
}
