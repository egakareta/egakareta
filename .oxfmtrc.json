{
    "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/refs/heads/main/npm/oxfmt/configuration_schema.json",
    "insertFinalNewline": true,
    "semi": true,
    "singleQuote": false,
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 80,
    "sortPackageJson": false,
    "ignorePatterns": [
        "*.lock",
        "**/assets/levels",
        "*.d.ts",
        "supabase/.temp",
        "_supabase_types.ts"
    ],
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.jsonc"],
            "options": {
                "trailingComma": "none"
            }
        }
    ]
}
