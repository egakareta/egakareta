{
    "name": "egakareta",
    "scripts": {
        "build": "bun scripts/build.ts",
        "build:native": "cargo build -p eg-app",
        "bench:hot-paths": "cargo bench -p eg-app --features benchmarks --bench perf_hot_paths",
        "format:cargo": "cargo fmt -- --config-path .config/rustfmt.toml",
        "format:prettier": "prettier --config .config/.prettierrc --ignore-path .gitignore --ignore-path .config/.prettierignore --write .",
        "format": "bun run format:cargo && bun run format:prettier",
        "lint": "cargo clippy --workspace -- -D warnings",
        "cf-typegen": "wrangler types --strict-vars=false --env-interface CloudflareEnv functions/cloudflare-env.d.ts",
        "sb-ts-typegen": "supabase gen types typescript --local > functions/_supabase_types.ts",
        "typegen": "bun cf-typegen && bun sb-ts-typegen",
        "test": "cargo test --workspace -- -Zunstable-options --format=terse",
        "test:egb": "cargo test -p egb",
        "test:coverage": "cargo llvm-cov --workspace --no-report -- -Zunstable-options --report-time && cargo llvm-cov report --lcov --output-path lcov.info && cargo llvm-cov report",
        "test:functions": "vitest run --config .config/vitest.config.mts",
        "test:db": "supabase test db",
        "license:add": "license-check-and-add add -f .config/license/config.json",
        "license:check": "license-check-and-add check -f .config/license/config.json",
        "dev:setup": "supabase start && until supabase status; do sleep 2; done && supabase status -o env > .env.local && bun typegen",
        "dev": "bun scripts/dev.ts",
        "prepare": "lefthook install"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.107.0"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.19.0",
        "@types/bun": "^1.3.14",
        "@vitest/coverage-istanbul": "4.1.10",
        "lefthook": "^2.1.10",
        "license-check-and-add": "^4.0.5",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.6",
        "prettier-plugin-toml": "^2.0.6",
        "supabase": "^2.110.0",
        "vitest": "^4.1.10",
        "wasm-pack": "^0.15.0",
        "wrangler": "^4.115.0"
    }
}
